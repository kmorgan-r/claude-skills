# Python bytecode / test caches
__pycache__/
*.pyc
.pytest_cache/

# Run artifacts — lead exports may contain personal data (GDPR); never commit.
# outputs/ is the documented write target; keep the dir, not its contents.
**/outputs/*
!**/outputs/.gitkeep

# Generated Excel workbooks (regenerable presentation artifacts derived from
# snapshot data); the canonical snapshot CSVs stay tracked.
**/reports/*.xlsx

# Eval scratch
**/evals/predictions.json

# OS / editor
.DS_Store
Thumbs.db

# Ship / fix-pr-reviews pipeline state (per-run scratch)
.claude-ship-state.json
.claude-pr-fix-state.json
